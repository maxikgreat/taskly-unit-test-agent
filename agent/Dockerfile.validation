FROM node:22-bookworm-slim
WORKDIR /opt/taskly
COPY frontend/package*.json ./frontend/
RUN cd frontend && npm ci
COPY backend/package*.json backend/prisma.config.ts ./backend/
COPY backend/prisma ./backend/prisma
COPY backend/src/core/config.ts ./backend/src/core/config.ts
RUN cd backend && npm ci
COPY agent/package*.json ./agent/
RUN cd agent && npm ci --ignore-scripts
COPY agent/src ./agent/src
COPY agent/skills ./agent/skills
COPY frontend/vite.config.ts frontend/tsconfig.json ./frontend/
COPY backend/vitest.config.ts backend/tsconfig.json backend/openapi.json ./backend/
COPY agent/scripts/sandbox.sh /opt/taskly/sandbox.sh
USER node
WORKDIR /work
ENTRYPOINT ["sh", "/opt/taskly/sandbox.sh"]
