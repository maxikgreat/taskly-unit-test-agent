POSTGRES_HOST=localhost
POSTGRES_USER=taskly
POSTGRES_PASSWORD=taskly
POSTGRES_DB=taskly
DB_PORT=5432
API_PORT=8000
WEB_PORT=8080

# Optional local override; otherwise the URL is built from the values above.
# DATABASE_URL=postgresql://taskly:taskly@localhost:5432/taskly

# Unit test agent (DeepSeek API billing only; no OpenAI key/subscription).
# Set the key privately in your ignored .env or shell. Never commit a real key.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_REASONING_EFFORT=low
AGENT_MAX_ITERATIONS=24
AGENT_MAX_OUTPUT_TOKENS=8192
AGENT_MAX_TOTAL_TOKENS=160000
AGENT_MAX_CONTEXT_BYTES=180000
AGENT_API_TIMEOUT_MS=90000
AGENT_TEST_TIMEOUT_MS=120000
