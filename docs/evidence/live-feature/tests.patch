+import { act, renderHook } from '@testing-library/react'
+import { describe, expect, it } from 'vitest'
+import { useTodoFilters } from './useTodoFilters'
+import type { Todo } from '../types'
+
+const base: Todo = {
+  id: 1,
+  title: 'Task',
+  description: '',
+  priority: 'medium',
+  completed: false,
+  due_date: null,
+  created_at: '2026-10-01T12:00:00Z',
+  updated_at: '2026-10-01T12:00:00Z',
+}
+
+describe('useTodoFilters priority', () => {
+  it('starts on all priorities and narrows visible todos via setPriority', () => {
+    const high: Todo = { ...base, id: 2, priority: 'high' }
+    const low: Todo = { ...base, id: 3, priority: 'low' }
+    const { result } = renderHook(() => useTodoFilters([high, base, low]))
+
+    expect(result.current.priority).toBe('all')
+    expect(result.current.visible.map((todo) => todo.id).sort()).toEqual([1, 2, 3])
+
+    act(() => result.current.setPriority('high'))
+    expect(result.current.priority).toBe('high')
+    expect(result.current.visible).toEqual([high])
+  })
+})
