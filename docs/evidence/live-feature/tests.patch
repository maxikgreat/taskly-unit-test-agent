+import express from 'express';
+import request from 'supertest';
+import { afterEach, describe, it, expect, vi } from 'vitest';
+import { createDatabase } from '../src/core/database.ts';
+import { TodoRepository } from '../src/features/todos/repository.ts';
+import { createTodosRouter } from '../src/features/todos/router.ts';
+import { priorityFilterSchema } from '../src/features/todos/validators.ts';
+import { record, todo } from './fixture.ts';
+
+afterEach(() => vi.restoreAllMocks());
+
+function setupRouter() {
+  const repository = {
+    list: vi.fn().mockResolvedValue([todo]),
+    create: vi.fn().mockResolvedValue(todo),
+    get: vi.fn(),
+    update: vi.fn(),
+    delete: vi.fn(),
+  };
+  const app = express();
+  app.use(express.json());
+  app.use('/api/todos', createTodosRouter(repository));
+  return { app, repository };
+}
+
+describe('todo priority filtering', () => {
+  it('forwards a valid priority query to the repository', async () => {
+    const { app, repository } = setupRouter();
+    const response = await request(app).get('/api/todos').query({ priority: 'high' });
+    expect(response.status).toBe(200);
+    expect(response.body).toEqual([todo]);
+    expect(repository.list).toHaveBeenCalledWith('high');
+  });
+
+  it('lists without a filter when priority is absent', async () => {
+    const { app, repository } = setupRouter();
+    const response = await request(app).get('/api/todos');
+    expect(response.status).toBe(200);
+    expect(repository.list).toHaveBeenCalledWith(undefined);
+  });
+
+  it.each(['urgent', ''])('rejects an invalid priority without querying the repository: %j', async (priority) => {
+    const { app, repository } = setupRouter();
+    const response = await request(app).get('/api/todos').query({ priority });
+    expect(response.status).toBe(422);
+    expect(repository.list).not.toHaveBeenCalled();
+  });
+
+  it('scopes findMany by priority in the repository', async () => {
+    const database = createDatabase('postgresql://test:test@localhost:5432/test');
+    const repository = new TodoRepository(database);
+    const findMany = vi.spyOn(database.todo, 'findMany').mockResolvedValue([record]);
+    expect(await repository.list('high')).toEqual([todo]);
+    expect(findMany).toHaveBeenCalledWith({
+      orderBy: [{ created_at: 'desc' }, { id: 'desc' }],
+      where: { priority: 'high' },
+    });
+  });
+
+  it('omits the where clause when no priority is supplied', async () => {
+    const database = createDatabase('postgresql://test:test@localhost:5432/test');
+    const repository = new TodoRepository(database);
+    const findMany = vi.spyOn(database.todo, 'findMany').mockResolvedValue([record]);
+    expect(await repository.list()).toEqual([todo]);
+    expect(findMany).toHaveBeenCalledWith({
+      orderBy: [{ created_at: 'desc' }, { id: 'desc' }],
+    });
+  });
+});
+
+describe('priorityFilterSchema', () => {
+  it('accepts valid priorities and leaves absent values optional', () => {
+    expect(priorityFilterSchema.safeParse('high')).toEqual({ success: true, data: 'high' });
+    expect(priorityFilterSchema.safeParse(undefined)).toEqual({ success: true, data: undefined });
+  });
+
+  it.each(['urgent', '', 'HIGH', 'low,medium'])('rejects invalid priorities: %j', (value) => {
+    expect(priorityFilterSchema.safeParse(value).success).toBe(false);
+  });
+});
