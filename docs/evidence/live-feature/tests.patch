+import { describe, expect, it } from 'vitest'
+import { selectTodos } from './todos'
+import type { Todo } from '../types'
+
+const base: Todo = {
+  id: 1,
+  title: 'Sprint plan',
+  description: '',
+  priority: 'medium',
+  completed: false,
+  due_date: null,
+  created_at: '2026-10-01T12:00:00Z',
+  updated_at: '2026-10-01T12:00:00Z',
+}
+
+describe('selectTodos priority filtering', () => {
+  it('returns only todos matching the selected priority', () => {
+    const high: Todo = { ...base, id: 2, priority: 'high' }
+    const low: Todo = { ...base, id: 3, priority: 'low' }
+    expect(selectTodos([high, base, low], 'all', '', 'newest', 'high')).toEqual([high])
+  })
+
+  it("keeps every priority when 'all' is selected", () => {
+    const high: Todo = { ...base, id: 2, priority: 'high' }
+    const result = selectTodos([high, base], 'all', '', 'newest', 'all')
+    expect(result.map((todo) => todo.id).sort()).toEqual([1, 2])
+    expect(selectTodos([high, base], 'all', '', 'newest').map((todo) => todo.id).sort()).toEqual([1, 2])
+  })
+})
